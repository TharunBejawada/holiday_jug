# Copy to .env and fill in. `npm run dev` (root) loads this for all apps/packages.

# Aurora PostgreSQL connection string. Point every teammate at the same
# shared dev cluster, or at a personal branch/sandbox database later —
# same variable, just a different value.
# postgresql://<user>:<password>@<aurora-endpoint>:5432/<db>?schema=public&sslmode=require
DATABASE_URL="postgresql://holidayjug:changeme@holiday-jug-dev.cluster-xxxxxx.eu-west-2.rds.amazonaws.com:5432/holidayjug?schema=public&sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Shared secret for server-to-server / internal API calls
API_INTERNAL_SECRET="replace-with-a-long-random-string"

# AWS SES — sends the passwordless sign-in email (magic link).
# Locally, run `aws configure` so the SDK can find credentials; in
# production no keys are set here at all — the Amplify compute role is
# granted ses:SendEmail directly (see docs/DEPLOYMENT.md).
SES_REGION="eu-west-2"
SES_FROM_EMAIL="no-reply@holidayjug.com"

# AWS S3 — stores destination/hotel images and promo videos uploaded via
# the admin asset library. One shared bucket for everyone (local + prod),
# same as the shared Aurora/RDS instance — not a separate dev bucket.
S3_REGION="eu-west-2"
S3_BUCKET_NAME="holidayjug-assets-prod"
# Only needed if serving uploads through a CDN/custom domain instead of the
# bucket's default S3 URL. Leave unset to use the default.
# S3_PUBLIC_BASE_URL="https://assets.holidayjug.com"
