{
  "name": "holiday-jug",
  "private": true,
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate --workspace=@holiday-jug/db",
    "db:migrate": "npm run migrate:dev --workspace=@holiday-jug/db",
    "db:deploy": "npm run migrate:deploy --workspace=@holiday-jug/db",
    "db:studio": "npm run studio --workspace=@holiday-jug/db",
    "db:seed": "npm run seed --workspace=@holiday-jug/db"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  }
}
