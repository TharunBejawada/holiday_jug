// Holiday Jug — core data model
// Aurora PostgreSQL (Serverless v2) in production, local Postgres via docker-compose in dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bookings Booking[]
  reviews  Review[]

  @@map("users")
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  country     String
  region      String?
  description String?
  heroImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages Package[]

  @@index([country])
  @@map("destinations")
}

enum BoardType {
  SELF_CATERING
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

model Hotel {
  id            String   @id @default(cuid())
  name          String
  starRating    Int      @default(3)
  description   String?
  address       String?
  latitude      Float?
  longitude     Float?
  amenities     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packages Package[]

  @@map("hotels")
}

model Package {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  destinationId String
  hotelId       String
  boardType     BoardType @default(BED_AND_BREAKFAST)
  nights        Int
  basePriceGbp  Decimal   @db.Decimal(10, 2)
  departureAirport String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  departures  Departure[]
  bookings    Booking[]
  reviews     Review[]

  @@index([destinationId])
  @@index([hotelId])
  @@index([basePriceGbp])
  @@map("packages")
}

// A specific bookable date + price + inventory for a package
model Departure {
  id          String   @id @default(cuid())
  packageId   String
  departDate  DateTime
  returnDate  DateTime
  priceGbp    Decimal  @db.Decimal(10, 2)
  seatsTotal  Int
  seatsBooked Int      @default(0)
  createdAt   DateTime @default(now())

  package  Package   @relation(fields: [packageId], references: [id])
  bookings Booking[]

  @@index([packageId, departDate])
  @@map("departures")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  packageId     String
  departureId   String
  adults        Int           @default(2)
  children      Int           @default(0)
  totalPriceGbp Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  package   Package   @relation(fields: [packageId], references: [id])
  departure Departure @relation(fields: [departureId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Review {
  id        String   @id @default(cuid())
  packageId String
  userId    String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([packageId])
  @@map("reviews")
}
