// Holiday Jug — core data model
// Aurora PostgreSQL (Serverless v2) in production, local Postgres via docker-compose in dev.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  image         String?
  passwordHash  String?
  role          UserRole   @default(CUSTOMER)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  // Profile — collected on the post-signup "complete your profile" step,
  // all optional since a user can skip and fill in later.
  phone           String?
  phoneVerified   DateTime?
  addressLine1    String?
  addressLine2    String?
  city            String?
  postcode        String?
  country         String?
  preferredCurrency String  @default("GBP")
  marketingOptIn  Boolean  @default(false)

  // System / account lifecycle — not user-editable, used for admin views
  // and basic account security signals.
  status        UserStatus @default(ACTIVE)
  loginCount    Int        @default(0)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  signupIp      String?

  accounts       Account[]
  sessions       Session[]
  bookings       Booking[]
  reviews        Review[]
  savedPackages  SavedPackage[]
  searchHistory  SearchHistory[]

  @@map("users")
}

// One-time 6-digit codes emailed during signup to verify an address before
// the user is allowed to set a password. Deliberately separate from
// NextAuth's VerificationToken (magic-link) model below — different
// lifecycle (attempts/lockout) and shape (short code, not a long token).
model EmailOtp {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  purpose    String    @default("SIGNUP")
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@map("email_otps")
}

// Required by NextAuth's Prisma adapter (email magic-link sign-in persists
// tokens/sessions server-side regardless of JWT vs database session strategy).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Destination {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  country     String
  region      String?
  description String?
  heroImageUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages Package[]

  @@index([country])
  @@map("destinations")
}

enum BoardType {
  SELF_CATERING
  BED_AND_BREAKFAST
  HALF_BOARD
  FULL_BOARD
  ALL_INCLUSIVE
}

model Hotel {
  id            String   @id @default(cuid())
  name          String
  starRating    Int      @default(3)
  description   String?
  address       String?
  latitude      Float?
  longitude     Float?
  amenities     String[] @default([])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  packages Package[]

  @@map("hotels")
}

model Package {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  destinationId String
  hotelId       String
  boardType     BoardType @default(BED_AND_BREAKFAST)
  nights        Int
  basePriceGbp  Decimal   @db.Decimal(10, 2)
  departureAirport String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destination Destination @relation(fields: [destinationId], references: [id])
  hotel       Hotel        @relation(fields: [hotelId], references: [id])
  departures  Departure[]
  bookings    Booking[]
  reviews     Review[]
  savedBy     SavedPackage[]

  @@index([destinationId])
  @@index([hotelId])
  @@index([basePriceGbp])
  @@map("packages")
}

// A specific bookable date + price + inventory for a package
model Departure {
  id          String   @id @default(cuid())
  packageId   String
  departDate  DateTime
  returnDate  DateTime
  priceGbp    Decimal  @db.Decimal(10, 2)
  seatsTotal  Int
  seatsBooked Int      @default(0)
  createdAt   DateTime @default(now())

  package  Package   @relation(fields: [packageId], references: [id])
  bookings Booking[]

  @@index([packageId, departDate])
  @@map("departures")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  userId        String
  packageId     String
  departureId   String
  adults        Int           @default(2)
  children      Int           @default(0)
  totalPriceGbp Decimal       @db.Decimal(10, 2)
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user      User      @relation(fields: [userId], references: [id])
  package   Package   @relation(fields: [packageId], references: [id])
  departure Departure @relation(fields: [departureId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Review {
  id        String   @id @default(cuid())
  packageId String
  userId    String
  rating    Int
  title     String?
  body      String?
  createdAt DateTime @default(now())

  package Package @relation(fields: [packageId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([packageId])
  @@map("reviews")
}

// A customer's "saved for later" holiday — the heart-icon/wishlist feature.
model SavedPackage {
  id        String   @id @default(cuid())
  userId    String
  packageId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([userId, packageId])
  @@index([userId])
  @@map("saved_packages")
}

// One row per search a signed-in user runs, so we can show "recent searches".
model SearchHistory {
  id          String    @id @default(cuid())
  userId      String
  destination String?
  minPrice    Decimal?  @db.Decimal(10, 2)
  maxPrice    Decimal?  @db.Decimal(10, 2)
  nights      Int?
  departAfter DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

enum AssetType {
  IMAGE
  VIDEO
}

// Tracks files uploaded to S3 (destination/hotel photos, promo videos, etc.)
// so the app has a queryable record of what's in the bucket and can attach
// metadata (alt text, dimensions) without re-reading S3 on every request.
model Asset {
  id         String    @id @default(cuid())
  key        String    @unique
  url        String
  type       AssetType
  mimeType   String
  sizeBytes  Int
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@map("assets")
}
